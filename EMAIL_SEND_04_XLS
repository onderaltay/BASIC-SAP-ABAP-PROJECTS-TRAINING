*&---------------------------------------------------------------------*
*& Report ZON_EMAIL_04
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
REPORT ZON_EMAIL_04.

DATA: GO_GBT         TYPE REF TO CL_GBT_MULTIRELATED_SERVICE,
      GO_BCS         TYPE REF TO CL_BCS,
      GO_DOC_BCS     TYPE REF TO CL_DOCUMENT_BCS,
      GO_RECIPIENT   TYPE REF TO IF_RECIPIENT_BCS,
      GT_SOLI        TYPE TABLE OF SOLI,
      GS_SOLI        TYPE SOLI,
      GV_STATUS      TYPE BCS_RQST,
      GV_CONTENT     TYPE STRING.

DATA:GV_ATTACHMENT_SIZE   TYPE SOOD-OBJLEN,
     GT_I_ATT_CONTENT_HEX TYPE SOLIX_TAB,
     GV_ATT_CONTENT       TYPE STRING,
     GV_ATT_LINE TYPE STRING.



DATA: GT_STOCK TYPE TABLE OF ZON_STOK_LIST,
      GS_STOCK TYPE          ZON_STOK_LIST.


START-OF-SELECTION.


CREATE OBJECT GO_GBT.

SELECT * FROM ZON_STOK_LIST INTO TABLE GT_STOCK.

GV_CONTENT =   '<!DOCTYPE html>                                '
           &&  '    <html>                                     '
           &&  '      <head>                                   '
           &&  '        <meta charset="utf-8">                 '
           &&  '       <style>                                 '
           &&  '        th {                                   '
           &&  '              background-color: lightgreen;    '
           &&  '              border: 3px solid;               '
           &&  '            }                                  '
           &&  '        td {                                   '
           &&  '              background-color: lightblue;     '
           &&  '              border: 2px solid;               '
           &&  '           }                                   '
           &&  '       </style>                                '
           &&  '      </head>                                  '
           &&  '      <body>                                   '
           &&  '        <table>                                '
           &&  '          <tr>                                 '
           &&  '             <th>Stok ID</th>                  '
           &&  '             <th>Stok Ad#</th>                 '
           &&  '             <th>Stok Miktar#</th>             '
           &&  '             <th>Stok Konumu</th>              '
           &&  '             <th>Birim Stok Fiyat#</th>        '
           &&  '             <th>Birim Stok Maliyeti</th>      '
           &&  '             <th>Birim Sat## Fiyat#</th>       '
           &&  '             <th>Sat## Grubu</th>              '
           &&  '             <th>Ürün Tipi</th>                '
           &&  '             <th>Ürün Grubu</th>               '
           &&  '             <th>Sat#lm## Miktar</th>          '
           &&  '             <th>Sat#lacak Miktar</th>         '
           &&  '          </tr>                                '.

LOOP AT GT_STOCK INTO GS_STOCK.
  GV_CONTENT = GV_CONTENT
           &&  '          <tr>                                 '
           &&  '             <td>'&& GS_STOCK-STOCK_ID && '</td> '
           &&  '             <td>'&& GS_STOCK-STOCK_NAME &&'</td>   '
           &&  '             <td>'&& GS_STOCK-STOCK_QTY && '</td>     '
           &&  '             <td>'&& GS_STOCK-STOCK_LOC &&'</td>     '
           &&  '             <td>'&& GS_STOCK-STOCK_PRICE &&'</td>     '
           &&  '             <td>'&& GS_STOCK-STOCK_COST &&'</td>     '
           &&  '             <td>'&& GS_STOCK-STOCK_SELL &&'</td>     '
           &&  '             <td>'&& GS_STOCK-STOCK_DIV &&'</td>     '
           &&  '             <td>'&& GS_STOCK-STOCK_TYP &&'</td>     '
           &&  '             <td>'&& GS_STOCK-STOCK_PRD &&'</td>     '
           &&  '             <td>'&& GS_STOCK-STOCK_SOLD &&'</td>     '
           &&  '             <td>'&& GS_STOCK-STOCK_SALE &&'</td>     '
           &&  '          </tr>                                '.
  ENDLOOP.
  GV_CONTENT = GV_CONTENT
           &&  '        </table>                               '
           &&  '      </body>                                  '
           &&  '    </html>                                    '.


GT_SOLI = CL_DOCUMENT_BCS=>STRING_TO_SOLI( IP_STRING = GV_CONTENT ).

CALL METHOD GO_GBT->SET_MAIN_HTML
  EXPORTING
    CONTENT     =  GT_SOLI.

GO_DOC_BCS = CL_DOCUMENT_BCS=>CREATE_FROM_MULTIRELATED(
              I_SUBJECT          = 'Mail Ba#l###'
              I_MULTIREL_SERVICE = GO_GBT ).


LOOP AT GT_STOCK INTO GS_STOCK.
    CONCATENATE GS_STOCK-STOCK_ID
                GS_STOCK-STOCK_NAME
*                GS_STOCK-STOCK_QTY
                GS_STOCK-STOCK_LOC
*                GS_STOCK-STOCK_PRICE
*                GS_STOCK-STOCK_COST
*                GS_STOCK-STOCK_SELL
                GS_STOCK-STOCK_DIV
                GS_STOCK-STOCK_TYP
                GS_STOCK-STOCK_PRD
*                GS_STOCK-STOCK_SOLD
*                GS_STOCK-STOCK_SALE
                INTO GV_ATT_LINE
                SEPARATED BY CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB.
  IF SY-TABIX EQ 1 .
   GV_ATT_CONTENT = GV_ATT_LINE.
  ELSE.
   CONCATENATE GV_ATT_CONTENT
               GV_ATT_LINE
               INTO GV_ATT_CONTENT
               SEPARATED BY CL_ABAP_CHAR_UTILITIES=>NEWLINE.
  ENDIF.

ENDLOOP.

CL_BCS_CONVERT=>STRING_TO_SOLIX(
  EXPORTING
    IV_STRING   = GV_ATT_CONTENT
    IV_CODEPAGE = '4103'
    IV_ADD_BOM  = 'X'
  IMPORTING
    ET_SOLIX    = GT_I_ATT_CONTENT_HEX
    EV_SIZE     = GV_ATTACHMENT_SIZE ).


GO_DOC_BCS->ADD_ATTACHMENT(
  EXPORTING
    I_ATTACHMENT_TYPE     = 'xls'
    I_ATTACHMENT_SUBJECT  = 'Ürün/Stok Listesi'
    I_ATTACHMENT_SIZE     = GV_ATTACHMENT_SIZE
    I_ATT_CONTENT_HEX     = GT_I_ATT_CONTENT_HEX ).



GO_RECIPIENT = CL_CAM_ADDRESS_BCS=>CREATE_INTERNET_ADDRESS(
                   I_ADDRESS_STRING = 'onder@gmail.com' ).
GO_BCS = CL_BCS=>CREATE_PERSISTENT( ).
GO_BCS->SET_DOCUMENT( I_DOCUMENT = GO_DOC_BCS ).
GO_BCS->ADD_RECIPIENT(
  EXPORTING
    I_RECIPIENT     =     GO_RECIPIENT ).

GV_STATUS = 'N'.
CALL METHOD GO_BCS->SET_STATUS_ATTRIBUTES
  EXPORTING
    I_REQUESTED_STATUS = GV_STATUS .
GO_BCS->SEND( ).

COMMIT WORK.
IF SY-SUBRC EQ 0.
   MESSAGE 'Mail Gönderildi' TYPE 'I' DISPLAY LIKE 'S'.
ENDIF.
